# Branch Deployment Configuration (Each branch is hosted separately with its Branch ID)
# Copy the Branch ID generated by the Owner during Branch Creation in HQ:
VITE_BRANCH_ID=your_branch_id_here

# Razorpay Configuration
# Get these credentials from your Razorpay Dashboard (https://dashboard.razorpay.com/)

# Razorpay API Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id

# Razorpay API Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (created when you set up webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Key ID for Frontend (Vite requires VITE_ prefix)
# This should be the same as RAZORPAY_KEY_ID above
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Firebase Admin Configuration (Required for PDF Generation API)
# Get these from Project Settings > Service Accounts > Generate New Private Key
# Download the JSON, and copy the values:
FIREBASE_PROJECT_ID=maxmobiles-81e55
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@maxmobiles-81e55.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIkv...\n-----END PRIVATE KEY-----\n"
